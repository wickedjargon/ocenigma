import @bitboards::*
import std::result::Result
import std::sv::SV


enum EnPassant {
    False,
    True(position: Position)
}

struct Board {
    board: BitBoards,
    player: Player,
    white_oo: bool,
    white_ooo: bool,
    black_oo: bool,
    black_ooo: bool,
    en_passant: EnPassant
    half_moves: u64
    full_moves: u64
}

enum Move {
    from_pos: Position,
    to_pos: Position,
    RegularMove(),
    PromotionMove(promoted_piece: Piece),
}

def Board::print_board(&this) {
    let bitboards = .board
    .board.print_board()

    // Print the additional parameters
    let player_to_move = if .player == White then "White" else "Black"
    println("Player to move: %s", player_to_move)

    let white_oo_status = if .white_oo then "Yes" else "No"
    let white_ooo_status = if .white_ooo then "Yes" else "No"
    let black_oo_status = if .black_oo then "Yes" else "No"
    let black_ooo_status = if .black_ooo then "Yes" else "No"

    println("Castling rights:")
    println("  White kingside: %s", white_oo_status)
    println("  White queenside: %s", white_ooo_status)
    println("  Black kingside: %s", black_oo_status)
    println("  Black queenside: %s", black_ooo_status)

    match .en_passant {
        EnPassant::False => println("En passant: None"),
        EnPassant::True(position) => println("En passant: (%zu, %zu)", position.x, position.y)
    }

    println("Half-move clock: %zu", .half_moves)
    println("Full-move number: %zu", .full_moves)
}

def Board::get_move(&this, uci_move: SV): Move {
    let from_pos = Position::from_sv(uci_move.chop_left(2))
    let to_pos = Position::from_sv(uci_move.chop_left(2))
    if uci_move.len > 0 {
        let promoted_piece = Piece::from_char(uci_move[0], .player)
        return PromotionMove(from_pos, to_pos, promoted_piece)
    }
    return RegularMove(from_pos, to_pos)
}

def Board::move(&this, move: Move) {
    match move {
        RegularMove(from_pos, to_pos) => .board.move_piece(from_pos, to_pos)
        PromotionMove(from_pos, to_pos, promoted_piece) => {
            .board.move_piece(from_pos, to_pos)
            .board.place_piece(promoted_piece, to_pos)
        }
    }
    if .player == Black {
        .player = White
    } else {
        .player = Black
    }
}

def Board::from_fen(string: str): Result<Board, str> {
    let sv = SV::from_str(string)
    let fen_board = sv.chop_by_delim(' ')
    let fen_player = sv.chop_by_delim(' ')
    let fen_castling = sv.chop_by_delim(' ')
    let fen_en_passant = sv.chop_by_delim(' ')
    let half_moves = sv.chop_u64()
    let full_moves = sv.chop_u64()

    let player: Player = match fen_player {
        "w" => White
        "b" => Black
        else => { return Error("active player not valid in fen") }
    }

    let en_passant = match fen_en_passant {
        "-" => EnPassant::False
        else => EnPassant::True(Position::from_sv(fen_en_passant))
    }

    return Ok(Board(
        // board: match  Board::from_fen(fen_board) {
        //     Ok(val) => val,
        //     Err(err) => { return Err(err) },
        // },
        board: BitBoards::from_fen(fen_board)!,
        player: player,
        white_oo: fen_castling.contains('K'),
        white_ooo: fen_castling.contains('Q'),
        black_oo: fen_castling.contains('k'),
        black_ooo: fen_castling.contains('q'),
        en_passant: en_passant,
        half_moves: half_moves,
        full_moves: full_moves,
    ))
}

def Board::new_game(): Result<Board, str> {
    return Board::from_fen("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
}

enum Player {
    White,
    Black,
}

[formatting "(%zu, %zu)" "$.x, $.y"]
struct Position {
    x: u64,
   y: u64,
}

def Position::from_str(string: str): Position {
    assert string.len() == 2
    return Position((string[0] as u64 - 'a' as u64), string[1].get_digit() as u64 - 1)
}

def Position::from_sv(string: SV): Position {
    assert string.len == 2
    return Position((string[0] as u64 - 'a' as u64), string[1].get_digit() as u64 - 1)
}


def Position::get_mask(this): u64 => 1u64 << (.y * 8 + .x)


