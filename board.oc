import @bitboards::*
import @utils::*
import std::result::Result
import std::sv::SV

// let possible_moves: [[&Vector<Position>; 64]; 6]


// implement move like this?
// enum Move {
//     RegularMove(fromPos: Position, toPos: Position),
//     PromotionMove(fromPos: Position, toPos: Position, piece: Piece),
//     Castle(fromPos: Position, toPos: Position),
// }
//
// Draw/Resign are not moves here because they can
// occur during the  opposite player's turn

enum EnPassant {
    False,
    True(position: Position)
}

struct Board {
    board: BitBoards,
    player: Player,
    white_oo: bool,
    white_ooo: bool,
    black_oo: bool,
    black_ooo: bool,
    en_passant: EnPassant
    half_moves: u64
    full_moves: u64
}

enum Move {
    from_pos: Position,
    to_pos: Position,
    RegularMove(),
    PromotionMove(promoted_piece: Piece),
}

def Board::get_move(&this, uci_move: SV): Move {
    let from_pos = Position::from_sv(uci_move.chop_left(2))
    let to_pos = Position::from_sv(uci_move.chop_left(2))
    if uci_move.len > 0 {
        let promoted_piece = Piece::from_char(uci_move[0], this.player)
        return PromotionMove(from_pos, to_pos, promoted_piece)
    }
    return RegularMove(from_pos, to_pos)
}

def Board::move(&this, move: Move) {
    match move {
        RegularMove(from_pos, to_pos) => .board.move_piece(from_pos, to_pos)
        PromotionMove(from_pos, to_pos, promoted_piece) => {
            this.board.move_piece(from_pos, to_pos)
            this.board.place_piece(promoted_piece, to_pos)
        }
    }
    if .player == Black {
        .player = White
    } else {
        .player = Black
    }
}



def Board::from_fen(string: str): Result<Board, str> {
    let sv = SV::from_str(string)
    let fen_board = sv.chop_by_delim(' ')
    let fen_player = sv.chop_by_delim(' ')
    let fen_castling = sv.chop_by_delim(' ')
    let fen_en_passant = sv.chop_by_delim(' ')
    let half_moves = sv.chop_u64()
    let full_moves = sv.chop_u64()

    let player: Player = match fen_player {
        "w" => White
        "b" => Black
        else => { return Error("active player not valid in fen") }
    }

    let en_passant = match fen_en_passant {
        "-" => EnPassant::False
        else => EnPassant::True(Position::from_sv(fen_en_passant))
    }

    return Ok(Board(
        // board: match  Board::from_fen(fen_board) {
        //     Ok(val) => val,
        //     Err(err) => { return Err(err) },
        // },
        board: BitBoards::from_fen(fen_board)!,
        player: player,
        white_oo: fen_castling.contains('K'),
        white_ooo: fen_castling.contains('Q'),
        black_oo: fen_castling.contains('k'),
        black_ooo: fen_castling.contains('q'),
        en_passant: en_passant,
        half_moves: half_moves,
        full_moves: full_moves,
    ))
}

def Board::new_game(): Result<Board, str> {
    return Board::from_fen("rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1")
}



enum Player {
    White,
    Black,
}

[formatting "(%zu, %zu)" "$.x, $.y"]
struct Position {
    x: u64,
   y: u64,
}

def Position::from_str(string: str): Position {
    assert string.len() == 2
    return Position((string[0] as u64 - 'a' as u64), string[1].get_digit() as u64 - 1)
}

def Position::from_sv(string: SV): Position {
    assert string.len == 2
    return Position((string[0] as u64 - 'a' as u64), string[1].get_digit() as u64 - 1)
}

def Position::get_mask(this): u64 => 1u64 << (.y * 8 + 7 - .x)
