enum EnPassant {
    False,
    True(position: Position)
}

struct GameState {
    board: BitBoards,
    player: Player,
    white_oo: bool,
    white_ooo: bool,
    black_oo: bool,
    black_ooo: bool,
    en_passant: EnPassant
    half_moves: u64
    full_moves: u64
}

enum Move {
    from_pos: Position,
    to_pos: Position,
    RegularMove(),
    PromotionMove(promoted_piece: Piece),
}

