import std::sv::SV
import @position::*
import @utils::*
import std::result::Result

enum Piece {
    WhitePawn,
    WhiteRook,
    WhiteKnight,
    WhiteBishop,
    WhiteQueen,
    WhiteKing,
    BlackPawn,
    BlackRook,
    BlackKnight,
    BlackBishop,
    BlackQueen,
    BlackKing,
    EmptySquare,
}

def Piece::get_color(&this): Player {
    return match *this {
        WhitePawn => White,
        WhiteRook => White,
        WhiteKnight => White,
        WhiteBishop => White,
        WhiteQueen => White,
        WhiteKing => White
        BlackPawn => Black,
        BlackRook => Black,
        BlackKnight => Black,
        BlackBishop => Black,
        BlackQueen => Black,
        BlackKing => Black,
        EmptySquare => std::panic("empty square")
    }
}

def Piece::from_char(piece_char: char, player: Player): Piece {
    return match piece_char {
        'q' => match player {
            White => WhiteQueen
            Black => BlackQueen
        }
        'n' => match player {
            White => WhiteKnight
            Black => BlackKnight
        }
        'b' => match player {
            White => WhiteBishop
            Black => BlackBishop
        }
        'r' => match player {
            White => WhiteRook
            Black => BlackRook
        }
        else => std::panic("")
    }
}

struct Board {
    bitboards: [BitBoard; 12]
}

def Board::empty_board(): Board {
    let board: Board
    return board
}

def Board::place_piece(&this, piece: Piece, position: Position) {
    let bitboards = this as &u64
    let value = bitboards[piece as u64]
    value = value | position.get_mask()
    bitboards[piece as u64] = value
}

def Board::from_fen(fen: SV): Result<Board, str> {
    let board = Board::empty_board()
    for let y = 0u64; y < 8; y++ {
        let row = fen.chop_by_delim('/')
        let x = 0u64
        for piece in row.chars() {
            if piece.is_digit() {
                x += piece.get_digit() as BitBoard
                continue;
            }
            match piece {
                'r' => board.place_piece(BlackRook, Position(7 - x, 7 - y)),
                'R' => board.place_piece(WhiteRook, Position(7 - x, 7 - y)),
                'n' => board.place_piece(BlackKnight, Position(7 - x, 7 - y)),
                'N' => board.place_piece(WhiteKnight, Position(7 - x, 7 - y)),
                'b' => board.place_piece(BlackBishop, Position(7 - x, 7 - y)),
                'B' => board.place_piece(WhiteBishop, Position(7 - x, 7 - y)),
                'q' => board.place_piece(BlackQueen, Position(7 - x, 7 - y)),
                'Q' => board.place_piece(WhiteQueen, Position(7 - x, 7 - y)),
                'k' => board.place_piece(BlackKing, Position(7 - x, 7 - y)),
                'K' => board.place_piece(WhiteKing, Position(7 - x, 7 - y)),
                'p' => board.place_piece(BlackPawn, Position(7 - x, 7 - y)),
                'P' => board.place_piece(WhitePawn, Position(7 - x, 7 - y)),
                else => return Error("malformed fen")
            }
            x += 1
        }
    }
    return Ok(board)
}

def Board::get_piece_at_pos(&this, position: Position): Piece {
    let mask: u64 = position.get_mask()
    let bitboards = this as &u64
    for let i = 0; i < 12; i++ {
        if bitboards[i] & mask != 0 {
            return i as Piece
        }
    }
    return Piece::EmptySquare
}

def Board::move_piece(&this, origin: Position, destination: Position) {
    let piece = .get_piece_at_pos(origin)
    let bitboards = this as &u64
    assert piece != EmptySquare
    let value = bitboards[piece as u64]
    value = value & ~origin.get_mask()
    value = value | destination.get_mask()
    bitboards[piece as u64] = value
}

